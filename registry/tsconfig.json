{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/components/ui/button": ["./fixtures/button.tsx"],
      "@/lib/utils": ["./fixtures/utils.ts"],
      "happybirthdayvalera": ["../packages/react/src/index.ts"]
    }
  },
  "include": ["voice-listener", "fixtures"]
}
