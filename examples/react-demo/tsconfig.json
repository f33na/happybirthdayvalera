{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "happybirthdayvalera": ["../../packages/react/src/index.ts"],
      "happybirthdayvalera/evinvest": ["../../packages/react/src/evinvest/index.tsx"]
    }
  },
  "include": ["src", "../../registry/voice-listener"]
}
