{
  "$comment": "Runtime defaults for both libraries. Every value is overridable through the listener config.",
  "sampleRate": 16000,
  "vadThresholdRms": 0.012,
  "minSpeechMs": 250,
  "mode": "continuous",
  "silenceMs": 1500,
  "segmentSilenceMs": 700,
  "autoStopMs": 8000,
  "segmentPadBeforeMs": 200,
  "segmentPadAfterMs": 300,
  "maxDurationMs": 30000,
  "maxSegmentMs": 28000,
  "interimEveryMs": 1000,
  "holdMs": 300,
  "easterEggMs": 3000,
  "langCycle": ["en", "ru", "de", "fr"],
  "persistLangKey": "happybirthdayvalera.lang",
  "models": {
    "default": "tiny",
    "web": {
      "tiny": "onnx-community/whisper-tiny",
      "base": "onnx-community/whisper-base",
      "small": "onnx-community/whisper-small"
    },
    "desktop": {
      "baseUrl": "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/",
      "tiny": "ggml-tiny.bin",
      "base": "ggml-base.bin",
      "small": "ggml-small.bin"
    }
  }
}
