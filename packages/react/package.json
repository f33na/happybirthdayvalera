{
  "name": "happybirthdayvalera",
  "version": "0.1.0",
  "description": "A voice-input widget for React: mic button, animated waveform pill and local Whisper speech-to-text in en, ru, de and fr.",
  "keywords": ["speech-to-text", "voice-input", "whisper", "transformers.js", "react", "waveform"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f33na/happybirthdayvalera.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/types/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/types/index.d.ts", "default": "./dist/index.cjs" }
    },
    "./style.css": "./dist/style.css",
    "./whisper-worker.js": "./dist/whisper-worker.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:accuracy": "vitest run --config vitest.accuracy.config.ts",
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@huggingface/transformers": "3.8.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
